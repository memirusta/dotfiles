{
    "panelFamily": "ii",
    "appearance": {
        "fonts": {
            "main": "Rubik",
            "numbers": "Rubik",
            "title": "Rubik",
            "iconNerd": "CaskaydiaCove NF",
            "monospace": "CaskaydiaCove NF",
            "reading": "Rubik",
            "expressive": "Rubik"
        }
    },
    "background": {
        "wallpaperPath": "@HOME@/.config/hypr/cache/emir-transparent.mp4",
        "thumbnailPath": "",
        "wallpaperAnimation": "",
        "showBlur": false,
        "hideWhenFullscreen": true,
        "parallax": {
            "enableWorkspace": false
        },
        "widgets": {
            "clock": {
                "enable": true
            },
            "weather": {
                "enable": true,
                "placementStrategy": "leastBusy"
            },
            "calendar": {
                "enable": true,
                "placementStrategy": "leastBusy"
            },
            "media": {
                "enable": true,
                "placementStrategy": "leastBusy"
            },
            "resources": {
                "enable": true,
                "placementStrategy": "leastBusy"
            },
            "todo": {
                "enable": true,
                "placementStrategy": "leastBusy"
            }
        }
    },
    "bar": {
        "weather": {
            "enable": true,
            "enableGPS": false,
            "city": "Ankara"
        }
    }
}
