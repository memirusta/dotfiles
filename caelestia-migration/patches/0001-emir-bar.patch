diff --git a/modules/bar/components/emir/DisplayGroup.qml b/modules/bar/components/emir/DisplayGroup.qml
new file mode 100644
index 0000000..270859d
--- /dev/null
+++ b/modules/bar/components/emir/DisplayGroup.qml
@@ -0,0 +1,71 @@
+import QtQuick
+import QtQuick.Layouts
+import Caelestia.Config
+import qs.components
+import qs.services
+
+// Emir: wallpaper on/off, laptop panel Hz, GPU mode — the old "display" capsule.
+StyledRect {
+    id: root
+
+    color: Colours.tPalette.m3surfaceContainer
+    radius: Tokens.rounding.full
+
+    implicitWidth: Tokens.sizes.bar.innerWidth
+    implicitHeight: layout.implicitHeight + Tokens.padding.small * 2
+
+    EmirScript {
+        id: wallpaper
+
+        script: `${scriptsDir}/status/wallpaper-toggle-status.sh`
+        interval: 30000
+    }
+
+    EmirScript {
+        id: hz
+
+        script: `${scriptsDir}/status/refresh-rate-status.sh`
+        interval: 15000
+    }
+
+    EmirScript {
+        id: gpu
+
+        script: `${scriptsDir}/status/gpu-status.sh`
+        interval: 60000
+    }
+
+    ColumnLayout {
+        id: layout
+
+        anchors.centerIn: parent
+        spacing: 0
+
+        EmirButton {
+            readonly property bool off: wallpaper.cls === "wallpaper-off"
+
+            icon: off ? "hide_image" : "wallpaper"
+            colour: Colours.palette.m3secondary
+            dim: off
+            onLeftClicked: wallpaper.run(`${wallpaper.scriptsDir}/wallpaper-toggle.sh`)
+        }
+
+        EmirButton {
+            icon: "speed"
+            label: hz.ok ? hz.value.replace(/hz$/i, "") : "…"
+            colour: hz.cls === "hz-60" ? Colours.palette.m3onSurfaceVariant : Colours.palette.m3secondary
+            onLeftClicked: hz.run(`${hz.scriptsDir}/refresh-rate.sh toggle`)
+            onRightClicked: hz.run(`${hz.scriptsDir}/refresh-rate.sh menu`)
+        }
+
+        EmirButton {
+            // "󰢮 NV" -> "NV"
+            readonly property string mode: gpu.ok ? gpu.value.split(/\s+/).pop() : "…"
+
+            icon: "developer_board"
+            label: mode === "iGPU" ? "iG" : mode
+            colour: gpu.cls === "gpu-nvidia" ? Colours.palette.m3tertiary : Colours.palette.m3secondary
+            onLeftClicked: gpu.run(`${gpu.scriptsDir}/gpu-switch.sh`)
+        }
+    }
+}
diff --git a/modules/bar/components/emir/EmirButton.qml b/modules/bar/components/emir/EmirButton.qml
new file mode 100644
index 0000000..2bfd17f
--- /dev/null
+++ b/modules/bar/components/emir/EmirButton.qml
@@ -0,0 +1,68 @@
+import QtQuick
+import QtQuick.Layouts
+import Caelestia.Config
+import qs.components
+import qs.services
+
+// Emir: a single bar cell — icon and/or a short label, with left/right/middle click.
+Item {
+    id: root
+
+    property string icon
+    property string label
+    property color colour: Colours.palette.m3secondary
+    property real iconFill: 0
+    property bool dim: false
+
+    signal leftClicked
+    signal rightClicked
+    signal middleClicked
+
+    implicitWidth: Tokens.sizes.bar.innerWidth
+    implicitHeight: column.implicitHeight + Tokens.padding.small * 2
+
+    StateLayer {
+        radius: Tokens.rounding.full
+        acceptedButtons: Qt.LeftButton | Qt.RightButton | Qt.MiddleButton
+        onClicked: mouse => {
+            if (mouse.button === Qt.RightButton)
+                root.rightClicked();
+            else if (mouse.button === Qt.MiddleButton)
+                root.middleClicked();
+            else
+                root.leftClicked();
+        }
+    }
+
+    ColumnLayout {
+        id: column
+
+        anchors.centerIn: parent
+        spacing: 0
+        opacity: root.dim ? 0.55 : 1
+
+        MaterialIcon {
+            Layout.alignment: Qt.AlignHCenter
+            visible: root.icon.length > 0
+            animate: true
+            text: root.icon
+            color: root.colour
+            fill: root.iconFill
+        }
+
+        StyledText {
+            Layout.alignment: Qt.AlignHCenter
+            visible: root.label.length > 0
+            animate: true
+            text: root.label
+            color: root.colour
+            font: Tokens.font.mono.small
+        }
+
+        Behavior on opacity {
+            Anim {
+                type: Anim.DefaultEffects
+            }
+        }
+    }
+}
diff --git a/modules/bar/components/emir/EmirScript.qml b/modules/bar/components/emir/EmirScript.qml
new file mode 100644
index 0000000..459fcd9
--- /dev/null
+++ b/modules/bar/components/emir/EmirScript.qml
@@ -0,0 +1,94 @@
+import QtQuick
+import Quickshell
+import Quickshell.Io
+
+// Emir: polls a Waybar-style status script that prints {"text", "tooltip", "class"}.
+// Also runs one-off actions and refreshes the status when they finish.
+Item {
+    id: root
+
+    required property string script
+    property int interval: 10000
+
+    property string value
+    property string tooltip
+    property string cls
+    property bool ok
+
+    property bool pending
+
+    readonly property string scriptsDir: `${Quickshell.env("HOME")}/.config/hypr/scripts`
+
+    function refresh(): void {
+        if (statusProc.running)
+            pending = true;
+        else
+            statusProc.running = true;
+    }
+
+    // Runs a command; refreshes the status as soon as it exits, plus a couple of
+    // delayed refreshes for scripts that hand work off to a background helper.
+    function run(command: string): void {
+        const proc = actionComp.createObject(root, {
+            command: ["sh", "-c", command]
+        });
+        proc.running = true;
+        lateRefresh.restart();
+    }
+
+    visible: false
+
+    Process {
+        id: statusProc
+
+        command: ["sh", "-c", root.script]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                const lines = this.text.trim().split("\n");
+                try {
+                    const j = JSON.parse(lines[lines.length - 1]);
+                    root.value = String(j.text ?? "").trim();
+                    root.tooltip = String(j.tooltip ?? "");
+                    root.cls = String(j.class ?? "");
+                    root.ok = true;
+                } catch (e) {
+                    root.ok = false;
+                }
+            }
+        }
+        onExited: {
+            if (root.pending) {
+                root.pending = false;
+                running = true;
+            }
+        }
+    }
+
+    Component {
+        id: actionComp
+
+        Process {
+            id: action
+
+            onExited: {
+                root.refresh();
+                action.destroy();
+            }
+        }
+    }
+
+    Timer {
+        interval: root.interval
+        running: true
+        repeat: true
+        triggeredOnStart: true
+        onTriggered: root.refresh()
+    }
+
+    Timer {
+        id: lateRefresh
+
+        interval: 2500
+        onTriggered: root.refresh()
+    }
+}
diff --git a/modules/bar/components/emir/Hardware.qml b/modules/bar/components/emir/Hardware.qml
new file mode 100644
index 0000000..2d5aaee
--- /dev/null
+++ b/modules/bar/components/emir/Hardware.qml
@@ -0,0 +1,107 @@
+import QtQuick
+import QtQuick.Layouts
+import Quickshell
+import Caelestia.Config
+import Caelestia.Services
+import qs.components
+import qs.services
+
+// Emir: CPU / RAM / disk drawer. Shows CPU; hovering unfolds RAM and disk. Click opens btop.
+StyledRect {
+    id: root
+
+    readonly property bool expanded: hover.containsMouse
+
+    color: Colours.tPalette.m3surfaceContainer
+    radius: Tokens.rounding.full
+    clip: true
+
+    implicitWidth: Tokens.sizes.bar.innerWidth
+    implicitHeight: layout.implicitHeight + Tokens.padding.small * 2
+
+    ServiceRef {
+        service: Cpu
+    }
+
+    ServiceRef {
+        service: Memory
+    }
+
+    ServiceRef {
+        service: Storage
+    }
+
+    StateLayer {
+        id: hover
+
+        radius: Tokens.rounding.full
+        onClicked: Quickshell.execDetached(["kitty", "--class", "dotfiles-floating", "-e", "btop"])
+    }
+
+    ColumnLayout {
+        id: layout
+
+        anchors.horizontalCenter: parent.horizontalCenter
+        anchors.top: parent.top
+        anchors.topMargin: Tokens.padding.small
+        spacing: Tokens.spacing.extraSmall
+
+        Stat {
+            icon: "memory"
+            value: Cpu.percentage
+            colour: Colours.palette.m3primary
+        }
+
+        Stat {
+            icon: "memory_alt"
+            value: Memory.percentage
+            colour: Colours.palette.m3tertiary
+            shown: root.expanded
+        }
+
+        Stat {
+            icon: "hard_drive"
+            value: Storage.primaryDisk?.perc ?? 0
+            colour: Colours.palette.m3secondary
+            shown: root.expanded
+        }
+    }
+
+    Behavior on implicitHeight {
+        Anim {}
+    }
+
+    component Stat: ColumnLayout {
+        id: stat
+
+        property string icon
+        property real value
+        property color colour
+        property bool shown: true
+
+        Layout.alignment: Qt.AlignHCenter
+        Layout.preferredHeight: shown ? implicitHeight : 0
+        spacing: 0
+        opacity: shown ? 1 : 0
+        visible: opacity > 0
+
+        MaterialIcon {
+            Layout.alignment: Qt.AlignHCenter
+            text: stat.icon
+            color: stat.colour
+        }
+
+        StyledText {
+            Layout.alignment: Qt.AlignHCenter
+            text: isNaN(stat.value) ? "–" : String(Math.round(stat.value * 100))
+            color: stat.colour
+            font: Tokens.font.mono.small
+        }
+
+        Behavior on opacity {
+            Anim {
+                type: Anim.DefaultEffects
+            }
+        }
+    }
+}
diff --git a/modules/bar/components/emir/PinnedApps.qml b/modules/bar/components/emir/PinnedApps.qml
new file mode 100644
index 0000000..6932709
--- /dev/null
+++ b/modules/bar/components/emir/PinnedApps.qml
@@ -0,0 +1,115 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Layouts
+import Quickshell
+import Quickshell.Io
+import Quickshell.Hyprland
+import Quickshell.Widgets
+import Caelestia.Config
+import qs.components
+import qs.services
+
+// Emir: Windows-style pinned apps.
+//   left click ... launch, or focus it; clicking the focused app minimizes it (special:minimized)
+//   middle ....... open a new instance
+// Pinned list: ~/.config/caelestia/emir.json -> { "pinned": ["google-chrome", ...] } (desktop entry ids)
+ColumnLayout {
+    id: root
+
+    property list<string> pinned: ["google-chrome", "spotify", "code-oss", "com.system76.CosmicFiles"]
+
+    spacing: 0
+
+    FileView {
+        path: `${Quickshell.env("HOME")}/.config/caelestia/emir.json`
+        watchChanges: true
+        printErrors: false
+        onFileChanged: reload()
+        onLoaded: {
+            try {
+                const j = JSON.parse(text());
+                if (Array.isArray(j.pinned))
+                    root.pinned = j.pinned;
+            } catch (e) {}
+        }
+    }
+
+    Repeater {
+        model: root.pinned
+
+        delegate: Item {
+            id: app
+
+            required property string modelData
+
+            readonly property DesktopEntry entry: DesktopEntries.heuristicLookup(modelData)
+            readonly property list<string> classes: [modelData, entry?.id ?? "", entry?.startupClass ?? ""].filter(c => c.length > 0).map(c => c.toLowerCase())
+            readonly property list<HyprlandToplevel> windows: Hypr.toplevels.values.filter(t => classes.includes((t.lastIpcObject?.class ?? "").toLowerCase()))
+            readonly property bool running: windows.length > 0
+            readonly property bool focused: windows.some(t => t.address === Hypr.activeToplevel?.address)
+
+            function dispatchFor(t: HyprlandToplevel, lua: string, legacy: string): void {
+                Hypr.dispatch(Hypr.usingLua ? lua.replace("%A", `address:0x${t.address}`) : legacy.replace("%A", `address:0x${t.address}`));
+            }
+
+            function activate(): void {
+                if (!running) {
+                    entry?.execute();
+                    return;
+                }
+
+                if (focused) {
+                    // Same as Windows: clicking the active app minimizes it
+                    const t = Hypr.activeToplevel;
+                    dispatchFor(t, `hl.dsp.window.move({ workspace = "special:minimized", follow = false, window = "%A" })`, "movetoworkspacesilent special:minimized,%A");
+                    return;
+                }
+
+                // Prefer a window that isn't parked on the minimized workspace; focusing a
+                // minimized one also works (windows.lua restores it on focus)
+                const t = windows.find(w => !(w.workspace?.name ?? "").startsWith("special:")) ?? windows[0];
+                dispatchFor(t, `hl.dsp.focus({ window = "%A" })`, "focuswindow %A");
+            }
+
+            Layout.alignment: Qt.AlignHCenter
+            implicitWidth: Tokens.sizes.bar.innerWidth
+            implicitHeight: Tokens.sizes.bar.innerWidth - Tokens.padding.extraSmall
+            visible: !!entry
+
+            StateLayer {
+                radius: Tokens.rounding.medium
+                acceptedButtons: Qt.LeftButton | Qt.MiddleButton
+                onClicked: mouse => {
+                    if (mouse.button === Qt.MiddleButton)
+                        app.entry?.execute();
+                    else
+                        app.activate();
+                }
+            }
+
+            IconImage {
+                anchors.centerIn: parent
+                asynchronous: true
+                implicitSize: Math.round(Tokens.sizes.bar.innerWidth * 0.6)
+                source: Quickshell.iconPath(app.entry?.icon ?? "", "application-x-executable")
+                opacity: app.running ? 1 : 0.75
+            }
+
+            // Running / focused indicator on the screen-edge side, like the Windows taskbar line
+            StyledRect {
+                anchors.left: parent.left
+                anchors.verticalCenter: parent.verticalCenter
+
+                implicitWidth: 3
+                implicitHeight: app.focused ? parent.height * 0.55 : app.running ? 6 : 0
+                radius: Tokens.rounding.full
+                color: app.focused ? Colours.palette.m3primary : Colours.palette.m3onSurfaceVariant
+
+                Behavior on implicitHeight {
+                    Anim {}
+                }
+            }
+        }
+    }
+}
diff --git a/modules/bar/components/emir/Updates.qml b/modules/bar/components/emir/Updates.qml
new file mode 100644
index 0000000..8b396ab
--- /dev/null
+++ b/modules/bar/components/emir/Updates.qml
@@ -0,0 +1,35 @@
+import QtQuick
+import Caelestia.Config
+import qs.components
+import qs.services
+
+// Emir: pending pacman + AUR updates (scripts/status/updates.sh).
+// Left click: install (floating kitty), right click: plain `yay` in kitty. Refreshes when the terminal closes.
+EmirButton {
+    id: root
+
+    readonly property int count: parseInt(status.value) || 0
+
+    icon: count > 0 ? "system_update_alt" : "check_circle"
+    label: count > 0 ? (count > 99 ? "99+" : String(count)) : ""
+    iconFill: count > 0 ? 1 : 0
+    dim: count === 0
+    colour: {
+        if (status.cls === "red")
+            return Colours.palette.m3error;
+        if (status.cls === "yellow")
+            return Colours.palette.m3tertiary;
+        return Colours.palette.m3secondary;
+    }
+
+    onLeftClicked: status.run(`${status.scriptsDir}/install-updates.sh`)
+    onRightClicked: status.run("kitty --class dotfiles-floating -e yay")
+    onMiddleClicked: status.refresh()
+
+    EmirScript {
+        id: status
+
+        script: `${scriptsDir}/status/updates.sh`
+        interval: 30 * 60 * 1000
+    }
+}
