/* Bluetooth cihaz listesi — telefon tarzı */

@import "shared.rasi"

configuration {
    font:                "Fira Sans 11";
    show-icons:          false;
    hide-scrollbar:      true;
    hover-select:        true;
    scroll-method:       1;
}

window {
    width:            26em;
    x-offset:         0em;
    y-offset:         2em;
    spacing:          0em;
    padding:          0em;
    margin:           0em;
    color:            #FFFFFF;
    border:           @border-width;
    border-color:     @color11;
    cursor:           "default";
    transparency:     "real";
    location:         north;
    anchor:           north;
    fullscreen:       false;
    enabled:          true;
    border-radius:    @border-radius;
    background-color: transparent;
}

mainbox {
    enabled:          true;
    spacing:          0em;
    padding:          0em;
    orientation:      horizontal;
    children:         [ "listbox" ];
    background-color: transparent;
    background-image: @current-image;
}

listview {
    lines:            14;
    fixed-height:     true;
}

textbox-prompt-colon {
    str:              "  󰂯";
}

entry {
    placeholder:      "Cihaz ara…";
}

element {
    padding:          0.85em 1em;
}

element selected.normal {
    background-color: @color5;
}

element-text {
    horizontal-align: 0.0;
}
