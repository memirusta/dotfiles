/* Bluetooth eşleştirme onayı — ekran ortası */

@import "shared.rasi"

configuration {
    font:                "Fira Sans 12";
    show-icons:          false;
    hide-scrollbar:      true;
}

window {
    width:            24em;
    location:         center;
    anchor:           center;
    x-offset:         0em;
    y-offset:         0em;
    border:           @border-width;
    border-color:     @color11;
    border-radius:    @border-radius;
    transparency:     "real";
    background-color: transparent;
}

mainbox {
    background-color: transparent;
    background-image: @current-image;
}

listview {
    lines:            2;
    fixed-height:     true;
}

textbox-prompt-colon {
    str:              "  󰂯";
}

entry {
    enabled:          false;
}
